<Window x:Class="VixzDesktop.PopOutPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Vixz - Floating Player"
        Icon="App.ico"
        Height="360" Width="640"
        MinHeight="220" MinWidth="340"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <!-- Outer Floating Glass Container -->
    <Border Background="Black"
            BorderBrush="{StaticResource AccentOrange}"
            BorderThickness="1.5"
            CornerRadius="12"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <!-- Sleek Glass Header Titlebar (ALWAYS VISIBLE for easy Drag & Close) -->
                <RowDefinition Height="34"/>
                <!-- Full Video Player Area -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ALWAYS-ACCESSIBLE DRAGGABLE GLASS TITLEBAR -->
            <Border Grid.Row="0"
                    Background="#E60D0D14"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    MouseDown="TitleBar_MouseDown">
                <Grid Margin="10,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" ClipToBounds="True" Width="18" Height="18" Margin="0,0,8,0">
                            <Image Source="App.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <TextBlock x:Name="MiniVideoTitle" Text="Vixz Floating Player" Foreground="White" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                    </StackPanel>

                    <!-- Header Action Buttons (Pin, Dock Back, Close) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Pin / Topmost Toggle -->
                        <Button x:Name="PinBtn" Content="📌" Style="{StaticResource IconActionButton}" Width="24" Height="24" ToolTip="Toggle Always-On-Top" Margin="0,0,3,0" Click="PinBtn_Click"/>
                        <!-- Dock Back / Restore to Main Window -->
                        <Button Content="🗖" Style="{StaticResource IconActionButton}" Width="24" Height="24" ToolTip="Dock Back to Main Window" Margin="0,0,3,0" Click="DockBackBtn_Click"/>
                        <!-- Close Window Button (Always Ready) -->
                        <Button Content="✕" Style="{StaticResource IconActionButton}" Width="24" Height="24" ToolTip="Close Mini Player" Background="#44FF3D00" Foreground="White" Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. VIDEO PLAYER AREA -->
            <Grid Grid.Row="1" Background="Black">
                <wv2:WebView2 x:Name="MiniWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

                <!-- 3. AUTO-HIDING UTILITY DECK (Fades in on mouse hover) -->
                <Border x:Name="FooterOverlay"
                        VerticalAlignment="Bottom"
                        Background="#E60D0D14"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="10,6"
                        Opacity="0.1"
                        MouseEnter="FooterOverlay_MouseEnter"
                        MouseLeave="FooterOverlay_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Seek & Play Controls -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="-10s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,3,0" Click="SeekMinus10_Click"/>
                            <Button Content="-5s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,3,0" Click="SeekMinus5_Click"/>
                            <Button x:Name="PlayPauseBtn" Content="⏯️" Style="{StaticResource IconActionButton}" Width="28" Height="28" Margin="0,0,3,0" Click="PlayPause_Click"/>
                            <Button Content="+5s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,3,0" Click="SeekPlus5_Click"/>
                            <Button Content="+10s" Style="{StaticResource GlassButton}" FontSize="10" Padding="5,3" Margin="0,0,6,0" Click="SeekPlus10_Click"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Screenshot -->
                            <Button Content="📸" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Take Screenshot" Margin="0,0,3,0" Click="Screenshot_Click"/>
                            <!-- Sleep Timer -->
                            <Button Content="🌙" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Sleep Timer (30m)" Margin="0,0,3,0" Click="Sleep_Click"/>
                            <!-- Quality Toggle -->
                            <Button x:Name="QualityBtn" Content="HD" Style="{StaticResource GlassButton}" FontSize="10" FontWeight="Bold" Width="30" Height="28" ToolTip="Toggle 1080p HD / Auto Quality" Margin="0,0,3,0" Click="Quality_Click"/>
                            <!-- Thumbs Up -->
                            <Button x:Name="ThumbsUpBtn" Content="👍" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Like Video" Margin="0,0,3,0" Click="ThumbsUp_Click"/>
                            <!-- Thumbs Down -->
                            <Button x:Name="ThumbsDownBtn" Content="👎" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Dislike &amp; Remove Video" Margin="0,0,3,0" Click="ThumbsDown_Click"/>
                            <!-- Favorite -->
                            <Button x:Name="FavBtn" Content="⭐" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Favorite" Margin="0,0,3,0" Click="Favorite_Click"/>
                            <!-- Next Video -->
                            <Button Content="⏭️" Style="{StaticResource IconActionButton}" Width="28" Height="28" ToolTip="Next Video" Click="NextVideo_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
